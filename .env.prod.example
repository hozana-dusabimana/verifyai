# VerifyAI production environment — copy to .env.prod on the server, fill in
# real values, chmod 600. NEVER commit the filled-in .env.prod.
# Generate secrets with: openssl rand -hex 32

# ── Django core ───────────────────────────────────────────────────────────
SECRET_KEY=replace-with-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=api-verifyai.isiri.rw,verifyai.isiri.rw,127.0.0.1,localhost

# Demo users must NOT exist in production (see CREDENTIALS.md).
AUTO_SEED_DEMO_USERS=false

# ── Database (reuse host Percona/MySQL over TCP, NOT the docker bridge) ────
DB_ENGINE=django.db.backends.mysql
DB_NAME=verifyai
DB_USER=verifyai
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# ── Celery: eager/synchronous on this RAM-constrained box (no worker/redis) ─
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# ── CORS / CSRF (the SPA origin is the app domain) ────────────────────────
CORS_ALLOWED_ORIGINS=https://verifyai.isiri.rw
CSRF_TRUSTED_ORIGINS=https://verifyai.isiri.rw,https://api-verifyai.isiri.rw

# ── Misc ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://verifyai.isiri.rw
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@verifyai.isiri.rw
ALERT_CREDIBILITY_THRESHOLD=30

# Frontend build-time API base (must include /api/v1, no double /api).
# Consumed by docker-compose.prod.yml as the frontend build arg.
VITE_API_URL=https://api-verifyai.isiri.rw/api/v1
