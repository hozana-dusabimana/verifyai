# ── Stage 1: build the Vite SPA with the prod API base baked in ──────────
FROM node:20-alpine AS build

WORKDIR /app

# Absolute prod API base. api.js uses this verbatim as axios baseURL and calls
# endpoints like `/auth/login`, so the value MUST include the `/api/v1` suffix
# (no double `/api`). Passed at build time — changing it requires a rebuild.
ARG VITE_API_URL=https://api-verifyai.isiri.rw/api/v1
ENV VITE_API_URL=${VITE_API_URL}
# Cap Node heap so Vite/Rollup doesn't OOM on the small server.
ENV NODE_OPTIONS=--max-old-space-size=1024

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ── Stage 2: static nginx (NOT host-networked; mapped to 127.0.0.1 by compose) ──
FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
