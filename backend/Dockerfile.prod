FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        default-libmysqlclient-dev \
        pkg-config \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# Install CPU-only torch. The pytorch cpu index serves x86_64; on aarch64 the
# wheel lives on PyPI, so fall back there. Either way this is a CPU build (no CUDA).
RUN pip install --upgrade pip \
    && (pip install --index-url https://download.pytorch.org/whl/cpu torch==2.5.1 \
        || pip install torch==2.5.1) \
    && pip install -r requirements.txt

# Pre-download NLTK corpora used by preprocessing so first request doesn't fetch.
RUN python -c "import nltk; [nltk.download(p) for p in ('punkt','punkt_tab','stopwords','wordnet')]" || true

COPY . .

# Collect static (admin + DRF assets) into STATIC_ROOT for WhiteNoise to serve.
RUN python manage.py collectstatic --noinput || true

EXPOSE 8010

# Default command; overridden by docker-compose.prod.yml.
CMD ["gunicorn", "config.wsgi", "-b", "127.0.0.1:8010", "--workers", "1", "--threads", "4", "--timeout", "180"]
